{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estandar/scroll-panels",
	"title": "Scroll Panels",
	"category": "estandar-experience",
	"icon": "slides",
	"description": "Secuencia narrativa de paneles con progreso, entrada por scroll y layout responsive.",
	"keywords": [ "scroll", "panels", "story", "sections", "codrops" ],
	"textdomain": "estandar-experience-blocks",
	"attributes": {
		"panels": { "type": "array", "default": [] },
		"height": { "type": "number", "default": 88 },
		"effect": { "type": "string", "default": "slide" },
		"accentColor": { "type": "string", "default": "#111111" },
		"showProgress": { "type": "boolean", "default": true },
		"stickyMedia": { "type": "boolean", "default": true }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "estandar-efx-blocks-editor",
	"editorStyle": "estandar-efx-scroll-panels-css",
	"render": "file:./render.php"
}
