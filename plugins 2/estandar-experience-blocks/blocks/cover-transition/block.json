{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estandar/cover-transition",
	"title": "Cover Transition",
	"category": "estandar-experience",
	"icon": "slides",
	"description": "Lista editorial que abre una ficha de detalle con transición de cubierta configurable.",
	"keywords": [ "cover", "transition", "page", "overlay", "codrops" ],
	"textdomain": "estandar-experience-blocks",
	"attributes": {
		"items": { "type": "array", "default": [] },
		"height": { "type": "number", "default": 640 },
		"overlayColor": { "type": "string", "default": "#111111" },
		"textColor": { "type": "string", "default": "#f8fafc" },
		"transitionStyle": { "type": "string", "default": "split" },
		"duration": { "type": "number", "default": 760 },
		"showMeta": { "type": "boolean", "default": true }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "estandar-efx-blocks-editor",
	"editorStyle": "estandar-efx-cover-transition-css",
	"render": "file:./render.php"
}
