{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estandar/horizontal-parallax-gallery",
	"title": "Horizontal Parallax Gallery",
	"category": "estandar-experience",
	"icon": "images-alt2",
	"description": "Galería horizontal con parallax DOM, útil como hero visual o carrusel editorial.",
	"keywords": [
		"horizontal",
		"parallax",
		"gallery",
		"hero",
		"carousel"
	],
	"textdomain": "estandar-experience",
	"attributes": {
		"slides": {
			"type": "array",
			"default": []
		},
		"height": {
			"type": "number",
			"default": 200
		},
		"imageWidth": {
			"type": "number",
			"default": 360
		},
		"imageHeight": {
			"type": "number",
			"default": 460
		},
		"radius": {
			"type": "number",
			"default": 21
		},
		"bgColor": {
			"type": "string",
			"default": "#050505"
		},
		"endAlign": {
			"type": "string",
			"default": "right",
			"enum": [
				"right",
				"center",
				"left"
			]
		},
		"gap": {
			"type": "number",
			"default": 28
		},
		"speed": {
			"type": "number",
			"default": 1
		},
		"depth": {
			"type": "number",
			"default": 1
		},
		"heroMode": {
			"type": "boolean",
			"default": true
		},
		"showCaptions": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "estandar-experience-editor",
	"editorStyle": "estandar-experience-editor-css"
}
