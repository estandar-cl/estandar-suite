{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estandar/scroll-synced-carousel",
	"title": "Scroll Synced Carousel",
	"category": "estandar-experience",
	"icon": "slides",
	"description": "Carrusel sincronizado con scroll, con progreso y narrativa lateral.",
	"keywords": [
		"scroll",
		"synced",
		"carousel",
		"swiper",
		"gallery"
	],
	"textdomain": "estandar-experience",
	"attributes": {
		"slides": {
			"type": "array",
			"default": []
		},
		"height": {
			"type": "number",
			"default": 92
		},
		"cardWidth": {
			"type": "number",
			"default": 420
		},
		"gap": {
			"type": "number",
			"default": 26
		},
		"accentColor": {
			"type": "string",
			"default": "#f97316"
		},
		"showProgress": {
			"type": "boolean",
			"default": true
		},
		"snap": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "estandar-experience-editor",
	"editorStyle": "estandar-experience-editor-css"
}
