{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "estandar/spatial-gallery",
	"title": "Spatial Gallery",
	"category": "estandar-experience",
	"icon": "format-gallery",
	"description": "Galería editorial de imágenes flotantes con foco, cursor contextual y layout mobile-safe.",
	"keywords": [
		"spatial",
		"gallery",
		"codrops",
		"floating",
		"galeria"
	],
	"textdomain": "estandar-experience",
	"attributes": {
		"slides": {
			"type": "array",
			"default": []
		},
		"height": {
			"type": "number",
			"default": 720
		},
		"imageWidth": {
			"type": "number",
			"default": 280
		},
		"spread": {
			"type": "number",
			"default": 1
		},
		"focusScale": {
			"type": "number",
			"default": 1.18
		},
		"showCaptions": {
			"type": "boolean",
			"default": true
		},
		"showIndex": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "estandar-experience-editor",
	"editorStyle": "estandar-experience-editor-css"
}
